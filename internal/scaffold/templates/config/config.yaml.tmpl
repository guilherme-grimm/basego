server:
  port: 8080
  shutdown_timeout: 30s

log:
  level: info
  json: true

observability:
  service_name: {{.Name}}
  otlp_endpoint: localhost:4317   # otel-collector; override for a real backend
  metrics_path: /metrics          # promhttp exposition scraped by Prometheus
  trace_sample_ratio: 1.0         # consumed once otel deep-wire lands (post-v1)

service:
  example:
    enabled: true
    driver: memory
{{if or (.HasDriver "mongo") (.HasDriver "postgres")}}
resources:
{{- if .HasDriver "mongo"}}
  mongo:
    uri: mongodb://localhost:27017
    database: {{.Name}}
{{- end}}
{{- if .HasDriver "postgres"}}
  postgres:
    dsn: postgres://user:pass@localhost:5432/{{.Name}}
{{- end}}
{{- end}}
