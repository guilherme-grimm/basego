package postgres

import (
	"context"
	"database/sql"
	"errors"
	"fmt"

	"github.com/jmoiron/sqlx"

	exampleentity "{{.Module}}/internal/domain/entity/example"
	"{{.Module}}/internal/resource/database/postgres/sqlcgen"
)

// ExampleRepo is the postgres implementation of the example slice's Repo
// port, backed by the sqlc queries in queries/example.sql.
type ExampleRepo struct {
	q *sqlcgen.Queries
}

// NewExampleRepo returns a Repo bound to db. Wired in cmd/api/services.go.
func NewExampleRepo(db *sqlx.DB) *ExampleRepo {
	return &ExampleRepo{q: sqlcgen.New(db)}
}

// Save upserts e by ID.
func (r *ExampleRepo) Save(ctx context.Context, e *exampleentity.Example) error {
	if err := r.q.UpsertExample(ctx, sqlcgen.UpsertExampleParams{ID: e.ID, Name: e.Name}); err != nil {
		return fmt.Errorf("postgres: save example %s: %w", e.ID, err)
	}
	return nil
}

// FindByID returns the example or exampleentity.ErrNotFound.
func (r *ExampleRepo) FindByID(ctx context.Context, id string) (*exampleentity.Example, error) {
	row, err := r.q.GetExample(ctx, id)
	if errors.Is(err, sql.ErrNoRows) {
		return nil, exampleentity.ErrNotFound
	}
	if err != nil {
		return nil, fmt.Errorf("postgres: find example %s: %w", id, err)
	}
	return &exampleentity.Example{ID: row.ID, Name: row.Name}, nil
}
