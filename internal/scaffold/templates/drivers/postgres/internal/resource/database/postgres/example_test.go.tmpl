package postgres_test

import (
	"context"
	"errors"
	"fmt"
	"os"
	"testing"
	"time"

	_ "github.com/jackc/pgx/v5/stdlib"
	"github.com/jmoiron/sqlx"

	exampleentity "{{.Module}}/internal/domain/entity/example"
	"{{.Module}}/internal/resource/database/postgres"
)

// TestExampleRepo runs against a real database with schema/ applied, e.g.
// `docker compose up -d postgres` then
// TEST_POSTGRES_DSN=postgres://user:pass@localhost:5432/{{.Name}}?sslmode=disable go test ./...
func TestExampleRepo(t *testing.T) {
	dsn := os.Getenv("TEST_POSTGRES_DSN")
	if dsn == "" {
		t.Skip("TEST_POSTGRES_DSN not set")
	}
	db, err := sqlx.Open("pgx", dsn)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = db.Close() })

	ctx := context.Background()
	repo := postgres.NewExampleRepo(db)
	id := fmt.Sprintf("test-%d", time.Now().UnixNano())

	if err := repo.Save(ctx, &exampleentity.Example{ID: id, Name: "first"}); err != nil {
		t.Fatalf("Save: %v", err)
	}
	if err := repo.Save(ctx, &exampleentity.Example{ID: id, Name: "second"}); err != nil {
		t.Fatalf("Save (upsert): %v", err)
	}
	got, err := repo.FindByID(ctx, id)
	if err != nil {
		t.Fatalf("FindByID: %v", err)
	}
	if got.Name != "second" {
		t.Errorf("Name = %q, want %q after upsert", got.Name, "second")
	}

	if _, err := repo.FindByID(ctx, id+"-missing"); !errors.Is(err, exampleentity.ErrNotFound) {
		t.Errorf("FindByID(missing) err = %v, want ErrNotFound", err)
	}
}
