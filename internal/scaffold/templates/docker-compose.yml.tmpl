# docker-compose.yml — local stack for {{.Name}}. Generated by basego.
# Database and observability hostnames resolve to compose service names;
# override the corresponding config/env values for a real environment.
# Grafana: http://localhost:3000 (anonymous admin, local only).
services:
  app:
    build: .
    ports:
      - "8080:8080"
{{- if or (.HasDriver "mongo") (.HasDriver "postgres") }}
    depends_on:
{{- if .HasDriver "mongo" }}
      mongo:
        condition: service_healthy
{{- end }}
{{- if .HasDriver "postgres" }}
      postgres:
        condition: service_healthy
{{- end }}
{{- end }}
    environment:
      OBSERVABILITY_OTLP_ENDPOINT: otel-collector:4317
{{- if .HasDriver "mongo" }}
      RESOURCES_MONGO_URI: mongodb://mongo:27017
      RESOURCES_MONGO_DATABASE: {{.Name}}
{{- end }}
{{- if .HasDriver "postgres" }}
      RESOURCES_POSTGRES_DSN: postgres://user:pass@postgres:5432/{{.Name}}?sslmode=disable
{{- end }}
{{- if .HasDriver "mongo" }}

  mongo:
    image: mongo:7
    ports:
      - "27017:27017"
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end }}
{{- if .HasDriver "postgres" }}

  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: pass
      POSTGRES_DB: {{.Name}}
    volumes:
      # Applied on first start only; `docker compose down -v` to re-apply.
      - ./internal/resource/database/postgres/schema:/docker-entrypoint-initdb.d:ro
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d {{.Name}}"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end }}

  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.128.0
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ./observability/otel-collector.yaml:/etc/otelcol/config.yaml:ro
    ports:
      - "4317:4317"
      - "4318:4318"

  prometheus:
    image: prom/prometheus:v3.4.0
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --web.enable-remote-write-receiver
    volumes:
      - ./observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    ports:
      - "9090:9090"

  loki:
    image: grafana/loki:3.5.0
    command: ["-config.file=/etc/loki/config.yaml"]
    volumes:
      - ./observability/loki.yaml:/etc/loki/config.yaml:ro
    ports:
      - "3100:3100"

  tempo:
    image: grafana/tempo:2.8.0
    command: ["-config.file=/etc/tempo/config.yaml"]
    volumes:
      - ./observability/tempo.yaml:/etc/tempo/config.yaml:ro
    ports:
      - "3200:3200"

  grafana:
    image: grafana/grafana:12.0.0
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
    volumes:
      - ./observability/grafana/datasources.yaml:/etc/grafana/provisioning/datasources/datasources.yaml:ro
    ports:
      - "3000:3000"
