# docker-compose.yml — local stack for {{.Name}}. Generated by basego.
# Database hostnames resolve to compose service names; override the
# corresponding config/env values when pointing at a real environment.
services:
  app:
    build: .
    ports:
      - "8080:8080"
{{- if or (.HasDriver "mongo") (.HasDriver "postgres") }}
    depends_on:
{{- if .HasDriver "mongo" }}
      mongo:
        condition: service_healthy
{{- end }}
{{- if .HasDriver "postgres" }}
      postgres:
        condition: service_healthy
{{- end }}
    environment:
{{- if .HasDriver "mongo" }}
      RESOURCES_MONGO_URI: mongodb://mongo:27017
      RESOURCES_MONGO_DATABASE: {{.Name}}
{{- end }}
{{- if .HasDriver "postgres" }}
      RESOURCES_POSTGRES_DSN: postgres://user:pass@postgres:5432/{{.Name}}?sslmode=disable
{{- end }}
{{- end }}
{{- if .HasDriver "mongo" }}

  mongo:
    image: mongo:7
    ports:
      - "27017:27017"
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end }}
{{- if .HasDriver "postgres" }}

  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: pass
      POSTGRES_DB: {{.Name}}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d {{.Name}}"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end }}
