package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.Module}}/internal/api"
)

func main() {
	cfg, err := LoadConfig(configPath())
	if err != nil {
		slog.Error("load config", "err", err)
		os.Exit(1)
	}
	logger, err := newLogger(cfg.Log)
	if err != nil {
		slog.Error("build logger", "err", err)
		os.Exit(1)
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	deps, err := buildDeps(ctx, cfg.Resources)
	if err != nil {
		logger.Error("setup resources", "err", err)
		os.Exit(1)
	}
	if _, err := buildServices(deps, cfg.Service, logger); err != nil {
		logger.Error("wire services", "err", err)
		closeDeps(logger, deps)
		os.Exit(1)
	}

	addr := fmt.Sprintf(":%d", cfg.Server.Port)

	srv := &http.Server{
		Addr:              addr,
		Handler:           api.NewRouter(),
		ReadHeaderTimeout: 5 * time.Second,
	}

	go func() {
		logger.Info("listening", "addr", addr)
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			logger.Error("server failed", "err", err)
			stop()
		}
	}()

	<-ctx.Done()
	logger.Info("shutting down")
	shutCtx, cancel := context.WithTimeout(context.Background(), cfg.Server.ShutdownTimeout)
	defer cancel()
	// Teardown order (DESIGN §9): drain inflight requests, then close pools.
	shutErr := srv.Shutdown(shutCtx)
	if shutErr != nil {
		logger.Error("shutdown", "err", shutErr)
	}
	closeDeps(logger, deps)
	if shutErr != nil {
		os.Exit(1)
	}
}

// closeDeps closes resources and logs, rather than returns, any failure:
// the process is exiting either way.
func closeDeps(logger *slog.Logger, deps Deps) {
	if err := deps.Close(); err != nil {
		logger.Error("close resources", "err", err)
	}
}
