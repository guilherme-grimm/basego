package main

import (
	"context"
{{- if .HasDriver "postgres" }}
	"errors"
	"fmt"

	"github.com/jmoiron/sqlx"
{{- end }}

	memresource "{{.Module}}/internal/resource/database/memory"
{{- if .HasDriver "mongo" }}
	mongoresource "{{.Module}}/internal/resource/database/mongo"
{{- end }}
)

// Deps groups runtime infra handles passed to buildServices. Each field
// is populated by a SetupX function in cmd/api/<driver>.go.
type Deps struct {
	Memory *memresource.Store
{{- if .HasDriver "mongo" }}
	Mongo *mongoresource.Client
{{- end }}
{{- if .HasDriver "postgres" }}
	Postgres *sqlx.DB
{{- end }}
}

// ResourcesConfig mirrors the resources block in config.yaml: one entry per
// selected driver. Memory needs no config.
type ResourcesConfig struct {
{{- if .HasDriver "mongo" }}
	Mongo MongoConfig `mapstructure:"mongo"`
{{- end }}
{{- if .HasDriver "postgres" }}
	Postgres PostgresConfig `mapstructure:"postgres"`
{{- end }}
}

// buildDeps dials every selected resource and fails fast when one is
// unreachable. On error, resources already opened are closed.
func buildDeps(ctx context.Context, cfg ResourcesConfig) (Deps, error) {
	d := Deps{Memory: SetupMemory()}
{{- if .HasDriver "postgres" }}

	pg, err := SetupPostgres(ctx, cfg.Postgres)
	if err != nil {
		return Deps{}, errors.Join(fmt.Errorf("setup postgres: %w", err), d.Close())
	}
	d.Postgres = pg
{{- end }}

	return d, nil
}

// Close releases every opened resource in reverse setup order.
func (d Deps) Close() error {
{{- if .HasDriver "postgres" }}
	var errs []error
	if d.Postgres != nil {
		if err := d.Postgres.Close(); err != nil {
			errs = append(errs, fmt.Errorf("close postgres: %w", err))
		}
	}
	return errors.Join(errs...)
{{- else }}
	return nil
{{- end }}
}
